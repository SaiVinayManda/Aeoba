# A persistent mounted directory is required for production request storage.
# Default for local development: .data in the project root.
AEOBA_DATA_DIR=

# Operator portal credentials. Sign-in stays locked until both secrets meet
# their minimum lengths. The public demo contains example data only.
AEOBA_PORTAL_EMAIL=info@aeoba.com
# Use at least 16 characters for the password and 32 for the session secret.
AEOBA_PORTAL_PASSWORD=
AEOBA_SESSION_SECRET=
